// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id             String    @id @default(uuid())
  externalId     String
  fleetId        String    @default("fleet-a")
  region         String?
  name           String
  location       String?
  conflictWithId String?
  createdAt      DateTime  @default(now())
  metrics        Metric[]
  anomalies      Anomaly[]

  @@unique([externalId, fleetId])
  @@index([region])
  @@map("devices")
}

model Metric {
  id           String     @id @default(uuid())
  deviceId     String
  device       Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ts           DateTime   @default(now())
  temperature_c Float
  vibration_g   Float
  humidity_pct  Float
  voltage_v     Float
  anomalies     Anomaly[]

  @@index([deviceId, ts])
  @@index([ts])
  @@map("metrics")
}

model Anomaly {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  metricId  String?
  metric    Metric?  @relation(fields: [metricId], references: [id], onDelete: SetNull)
  ts        DateTime @default(now())
  score     Float
  // Failure-mode classification: spike | drift | flatline | oscillation | sensor_swap
  type      String
  // Which metric channel triggered the classification (temperature_c | vibration_g | humidity_pct | voltage_v)
  metricChannel String?
  // Which detection engine produced this result (adaptive-baseline | median-deviation | zscore | isoforest)
  engine    String   @default("adaptive-baseline")
  flagged   Boolean  @default(true)

  @@index([deviceId, ts])
  @@index([ts])
  @@map("anomalies")
}

model Conflict {
  id        String   @id @default(uuid())
  region    String
  deviceIds Json
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region, status])
  @@map("conflicts")
}

model FleetMergeEvent {
  id                 String   @id @default(uuid())
  fleetId            String
  externalId         String
  resolvedDeviceId   String
  conflictingDeviceId String
  createdAt          DateTime @default(now())

  @@map("fleet_merge_events")
}

